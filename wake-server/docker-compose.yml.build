version: "3.9"
services:
  wake-server:
    container_name: wakeword-server 
    build: 
      context: .
      dockerfile: Dockerfile
    image: wakeword-server:latest
    ports:
      - "12201:12201"
    environment:
      - WAKE_WORD_MODEL=ok_nabu.onnx
      - WAKE_HOST=0.0.0.0
      - WAKE_PORT=12201
    volumes:
      - ./models:/models:rw
    restart: unless-stopped
